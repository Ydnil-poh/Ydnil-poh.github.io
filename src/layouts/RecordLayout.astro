---
interface Props {
  title: string;
  date: Date;
  location: string;
  tags: string[];
  type: 'standard' | 'mediaRail';
  slug: string;
  galleryImageUrls?: string[];
}

const { title, date, location, tags, type, slug, galleryImageUrls = [] } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long' }).format(date);
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Ydnil-poh Archive</title>
    <style>
      :root {
        --paper: #eeeae1;
        --ink: #24231d;
        --muted: #736f64;
        --line: #d8d1c3;
        --field: #f7f4ec;
        --olive: #6f7156;
        --rail: 220px;
        --rail-gap: 72px;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Iowan Old Style", "Apple SD Gothic Neo", "Noto Serif KR", serif; line-height: 1.88; }
      a { color: inherit; }
      .shell { width: min(840px, calc(100vw - 56px)); margin: 0 auto; padding: 44px 0 80px; }
      .shell--mediaRail { width: min(1180px, calc(100vw - 56px)); }
      .back { color: var(--muted); display: inline-block; font-family: "Inter", "Apple SD Gothic Neo", sans-serif; font-size: 13px; margin-bottom: 38px; text-decoration: none; }
      .shell--mediaRail .back { margin-left: calc(var(--rail) + var(--rail-gap)); }
      header { border-bottom: 1px solid var(--line); margin-bottom: 32px; padding-bottom: 28px; }
      .record-header--mediaRail { display: grid; gap: var(--rail-gap); grid-template-columns: var(--rail) minmax(0, 1fr); }
      .record-header--mediaRail .record-header__content { grid-column: 2; }
      h1 { font-size: 32px; font-weight: 500; letter-spacing: 0; line-height: 1.35; margin: 0 0 14px; }
      .shell--mediaRail h1 { font-size: clamp(34px, 4vw, 50px); line-height: 1.22; }
      .meta,.tags { color: var(--muted); font-family: "Inter", "Apple SD Gothic Neo", sans-serif; font-size: 13px; margin: 0; }
      .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
      .tag { border: 1px solid var(--line); padding: 2px 7px; }
      article :global(p) { font-size: 17px; margin: 0 0 22px; }
      article :global(img) { background: var(--field); border: 1px solid var(--line); display: block; height: auto; margin: 28px 0 34px; max-width: 100%; }
      .gallery { display: grid; gap: 14px; margin: 0 0 28px; }
      .gallery img { aspect-ratio: 4 / 3; border-radius: 8px; margin: 0; object-fit: cover; overflow: hidden; width: 100%; }
      article :global(a) { color: var(--olive); text-decoration-thickness: 1px; text-underline-offset: 4px; }
      article :global(.youtube-embed) { width: 100%; margin: 32px 0; }
      article :global(.youtube-embed iframe) { width: 100%; aspect-ratio: 16 / 9; display: block; border: 0; }
      .record-body--mediaRail {display: grid; grid-template-columns: var(--rail) minmax(0, 760px); gap: 0 var(--rail-gap); align-items: start; }
      .record-body__rail { grid-column: 1; }
      .record-body__content { grid-column: 2; min-width: 0; }
      .record-body__rail .gallery { display: grid; gap: 14px; }
      .record-body__rail .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; display: block; cursor: zoom-in;}
      .record-body__content :global(p) { font-size: 17px; margin: 0 0 22px; }
      .record-body--mediaRail :global(.gallery img),
      .record-body--mediaRail :global([data-gallery] img) { aspect-ratio: 4 / 3; border-radius: 8px; margin: 0 0 14px; object-fit: cover; overflow: hidden; width: 100%; }
      .record-body--mediaRail :global(.youtube-embed) { grid-column: 2; }
      .record-body--mediaRail :global(hr) { background: var(--line); border: 0; height: 1px; margin: 32px 0; width: 100%; }
      .record-body--mediaRail :global(blockquote) { background: rgba(247, 244, 236, 0.72); border: 0; border-radius: 6px; margin: 28px 0; padding: 18px 28px; }
      .record-body--mediaRail :global(h2),
      .record-body--mediaRail :global(h3) { line-height: 1.38; margin: 28px 0 14px; }
      @media (max-width: 860px) {
        .shell,
        .shell--mediaRail { width: min(840px, calc(100vw - 32px)); padding-top: 28px; }
        .shell--mediaRail .back { margin-left: 0; }
        .record-header--mediaRail,
        .record-body--mediaRail { display: block; }
        .record-body--mediaRail::before { content: none; }
        .record-body--mediaRail :global(.gallery),
        .record-body--mediaRail :global([data-gallery]),
        .record-body--mediaRail :global(.youtube-embed) { margin: 28px 0 34px; }
      }
      #lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.88);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        cursor: zoom-out;
      }

      #lightbox[hidden] {
        display: none;
      }
      
      #lightbox-image {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
      }
    </style>
  </head>
  <body>
    <main class:list={["shell", `shell--${type}`]}>
      <a class="back" href="/">back to archive field</a>
      <header class:list={["record-header", `record-header--${type}`]}>
        <div class="record-header__content">
          <h1>{title}</h1>
          <p class="meta">{formattedDate} / {location} / {type}</p>
          {tags.length > 0 && <div class="tags">{tags.map((tag) => <span class="tag">#{tag}</span>)}</div>}
        </div>
      </header>
      <article class:list={["record-body", `record-body--${type}`]}>
        {type === 'mediaRail' ? (
          <>
            <aside class="record-body__rail">
              {galleryImageUrls.length > 0 && (
                <div class="gallery" aria-label="record gallery">
                  {galleryImageUrls.map((url) => (
                    <img src={url} alt="" loading="lazy" />
                  ))}
                </div>
              )}
            </aside>
      
            <div class="record-body__content">
              <slot />
            </div>
              </>
        ) : (
          <slot />
        )}
      </article>
    </main>

    <div id="lightbox" hidden>
      <img id="lightbox-image" alt="" />
    </div>

    <script type="module" define:vars={{ slug, supabaseUrl, supabaseAnonKey }}>
      const backend = {
        url: supabaseUrl,
        key: supabaseAnonKey,
      };

      function sessionId() {
        const key = 'ydnil-poh-archive-session';
        const existing = sessionStorage.getItem(key);
        if (existing) return existing;
        const next = crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`;
        sessionStorage.setItem(key, next);
        return next;
      }

      async function recordPageView() {
        if (!backend.url || !backend.key || !slug) return;
        await fetch(`${backend.url.replace(/\/$/, '')}/rest/v1/rpc/record_archive_event`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: backend.key, Authorization: `Bearer ${backend.key}` },
          body: JSON.stringify({
            record_slug: slug,
            event_type: 'page_view',
            event_metadata: {
              path: window.location.pathname,
              referrer: document.referrer || '',
              sessionId: sessionId(),
              surface: 'record_page',
            },
          }),
          keepalive: true,
        });
      }

      recordPageView().catch(() => {});

      const lightbox = document.getElementById('lightbox');
      const lightboxImage = document.getElementById('lightbox-image');
      
      document
        .querySelectorAll('.record-body__rail .gallery img')
        .forEach((img) => {
          img.addEventListener('click', () => {
            lightboxImage.src = img.currentSrc || img.src;
            lightbox.hidden = false;
          });
        });
      
      lightbox?.addEventListener('click', () => {
        lightbox.hidden = true;
      });
      
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          lightbox.hidden = true;
        }
      });
    </script>
  </body>
</html>
