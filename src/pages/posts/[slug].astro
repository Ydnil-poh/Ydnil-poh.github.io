---
import { getCollection } from 'astro:content';

const stripExtension = (id: string) => id.replace(/\.(md|markdown|mdx)$/i, '');

export async function getStaticPaths() {
  const records = await getCollection('records', ({ data }) => data.visibility !== 'private');
  return records.map((record) => ({ params: { slug: stripExtension(record.id) }, props: { slug: stripExtension(record.id) } }));
}

const { slug } = Astro.props;
const target = `/records/${slug}/`;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting to archive record</title>
  </head>
  <body>
    <a href={target}>Open archive record</a>
  </body>
</html>
