---
import { getCollection, render } from 'astro:content';
import RecordLayout from '../../layouts/RecordLayout.astro';
import manifest from '../../../public/archive-manifest.json';

export async function getStaticPaths() {
  const records = await getCollection('records', ({ data }) => data.visibility !== 'private');
  return records.map((record) => {
    const slug = record.id.replace(/\.(md|markdown|mdx)$/i, '').toLowerCase();
    return { params: { slug }, props: { record } };
  });
}

const { record } = Astro.props;
const slug = record.id.replace(/\.(md|markdown|mdx)$/i, '').toLowerCase();
const { Content } = await render(record);
const manifestRecord = manifest.records.find((item) => item.slug === slug);
const galleryImageUrls = manifestRecord?.galleryImageUrls ?? [];
---

<RecordLayout
  title={record.data.title}
  date={record.data.date}
  location={record.data.location}
  tags={record.data.tags}
  type={record.data.type}
  slug={slug}
  galleryImageUrls={galleryImageUrls}
>
  <Content />
</RecordLayout>
