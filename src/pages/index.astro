---
interface Post {
  title: string;
  date: string;
  slug: string;
  excerpt: string;
}

// 나중에 동적으로 불러올 포스트들
const posts: Post[] = [];
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ydnil Strolls - 작은 모험들</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        font-family: "Hahmlet", serif;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #fafafa;
        color: #333;
        line-height: 1.8;
      }

      main {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }

      /* Header */
      .site-header {
        text-align: center;
        border-bottom: 2px solid #e0e0e0;
        padding-bottom: 2rem;
        margin-bottom: 3rem;
      }

      .site-title {
        font-size: 3rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
        color: #222;
      }

      .site-subtitle {
        font-size: 1.2rem;
        color: #999;
        margin: 0;
        font-weight: 400;
      }

      /* Posts Section */
      .posts-section {
        margin-bottom: 3rem;
      }

      .posts-section h2 {
        font-size: 1.8rem;
        color: #222;
        margin-bottom: 1.5rem;
      }

      .posts-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .post-item {
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #e0e0e0;
      }

      .post-item:last-child {
        border-bottom: none;
      }

      .post-link {
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
      }

      .post-link:hover {
        color: #0066cc;
      }

      .post-link h3 {
        font-size: 1.5rem;
        margin: 0 0 0.5rem 0;
        color: #222;
      }

      .post-link time {
        display: block;
        color: #999;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
      }

      .post-link p {
        margin: 0;
        color: #666;
        font-size: 1rem;
      }

      .no-posts {
        color: #999;
        font-style: italic;
      }

      /* Footer */
      .site-footer {
        text-align: center;
        border-top: 1px solid #e0e0e0;
        padding-top: 2rem;
        margin-top: 3rem;
        color: #999;
        font-size: 0.95rem;
      }

      /* Responsive */
      @media (max-width: 640px) {
        .site-title {
          font-size: 2rem;
        }

        main {
          padding: 1rem;
        }

        .site-header {
          padding-bottom: 1.5rem;
          margin-bottom: 2rem;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <header class="site-header">
        <h1 class="site-title">Ydnil Strolls</h1>
        <p class="site-subtitle">small adventures</p>
      </header>

      <section class="posts-section">
        <h2>최근 포스트</h2>
        {posts.length === 0 ? (
          <p class="no-posts">아직 포스트가 없습니다. 곧 추가될 예정입니다!</p>
        ) : (
          <ul class="posts-list">
            {posts.map((post) => (
              <li key={post.slug} class="post-item">
                <a href={`/posts/${post.slug}`} class="post-link">
                  <h3>{post.title}</h3>
                  <time>{post.date}</time>
                  <p>{post.excerpt}</p>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <footer class="site-footer">
        <p>&copy; 2026 Ydnil. All rights reserved.</p>
      </footer>
    </main>
  </body>
</html>