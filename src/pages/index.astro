---
import { getCollection } from 'astro:content';

const stripExtension = (id: string) => id.replace(/\.(md|markdown|mdx)$/i, '');
const hashNumber = (value: string) => [...value].reduce((sum, char) => (sum * 31 + char.charCodeAt(0)) % 100000, 17);
const normalize = (value: number, min: number, max: number) => max <= min ? 0.5 : Number(((value - min) / (max - min)).toFixed(4));

const sourceRecords = await getCollection('records', ({ data }) => data.visibility !== 'private');
const parsed = sourceRecords.map((record) => {
  const id = stripExtension(record.id);
  const body = record.body ?? '';
  const textCount = body.replace(/<[^>]+>/g, '').replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/\s/g, '').length;
  const markdownImages = [...body.matchAll(/!\[[^\]]*\]\(([^)]+)\)/g)].map((match) => match[1]);
  const htmlImages = [...body.matchAll(/<img\b[^>]*src=['"]([^'"]+)['"][^>]*>/gi)].map((match) => match[1]);
  const imageUrls = [record.data.cover, ...markdownImages, ...htmlImages].filter(Boolean);
  const rawScore = record.data.manualScore ?? textCount * 0.08 + imageUrls.length * 14 + record.data.tags.length * 6 + record.data.views * 0.8;
  const clusterSeed = [record.data.location, ...record.data.tags].join('|') || id;

  return {
    id,
    slug: id,
    title: record.data.title,
    date: record.data.date.toISOString(),
    location: record.data.location,
    excerpt: record.data.excerpt,
    type: record.data.type,
    tags: record.data.tags,
    cover: record.data.cover ?? '',
    coverAlt: record.data.coverAlt,
    url: `/records/${id}/`,
    imageUrls,
    textCount,
    rawScore,
    cluster: record.data.manualCluster ?? hashNumber(clusterSeed) % Math.max(4, Math.ceil(Math.sqrt(sourceRecords.length + 4)) + 3),
  };
});

const minScore = Math.min(...parsed.map((record) => record.rawScore), 0);
const maxScore = Math.max(...parsed.map((record) => record.rawScore), 1);
const records = parsed.map((record, index) => {
  const score = record.rawScore === record.rawScore ? normalize(record.rawScore, minScore, maxScore) : 0.5;
  const angle = (hashNumber(`${record.id}:${record.cluster}`) / 100000) * Math.PI * 2;
  const band = 0.16 + ((index + 1) / Math.max(parsed.length, 1)) * 0.68;
  const radius = Math.max(0.1, Math.min(0.86, band - score * 0.18));
  const x = 0.5 + Math.cos(angle) * radius * 0.46;
  const y = 0.5 + Math.sin(angle) * radius * 0.36;

  return {
    ...record,
    score,
    position: { x: Number(x.toFixed(4)), y: Number(y.toFixed(4)) },
  };
});

const relatedFor = (source: typeof records[number]) => records
  .filter((candidate) => candidate.id !== source.id)
  .map((candidate) => {
    const sharedTags = candidate.tags.filter((tag) => source.tags.includes(tag)).length;
    const location = candidate.location === source.location ? 1 : 0;
    const cluster = candidate.cluster === source.cluster ? 1 : 0;
    return { id: candidate.id, weight: sharedTags * 2 + location + cluster };
  })
  .filter((item) => item.weight > 0)
  .sort((a, b) => b.weight - a.weight)
  .slice(0, 8)
  .map((item) => item.id);

const fieldRecords = records.map((record) => ({ ...record, related: relatedFor(record) }));
const lines = fieldRecords.flatMap((record) => record.related.map((targetId) => {
  const target = fieldRecords.find((item) => item.id === targetId);
  if (!target) return null;
  return {
    source: record.id,
    target: target.id,
    x1: record.position.x * 100,
    y1: record.position.y * 100,
    x2: target.position.x * 100,
    y2: target.position.y * 100,
  };
}).filter(Boolean));

const selected = fieldRecords[0];
const archiveDate = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium' }).format(new Date());
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1440, initial-scale=1.0" />
    <title>Ydnil-poh Archive Field</title>
    <style>
      :root {
        --paper: #ede8de;
        --paper-2: #f7f3eb;
        --ink: #25231d;
        --muted: #6f6b60;
        --line: rgba(92, 83, 67, 0.2);
        --soft: rgba(107, 105, 83, 0.34);
        --olive: rgba(91, 95, 63, 0.62);
        --warm: rgba(197, 112, 67, 0.7);
      }

      * { box-sizing: border-box; }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: "Inter", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
        height: 100vh;
        margin: 0;
        overflow: hidden;
      }

      body::before {
        background: radial-gradient(circle at 50% 45%, rgba(255,255,255,0.5), transparent 58%);
        content: "";
        inset: 0;
        pointer-events: none;
        position: fixed;
      }

      .archive-shell {
        display: grid;
        gap: 24px;
        grid-template-columns: 178px minmax(0, 1fr) 292px;
        grid-template-rows: minmax(0, 1fr);
        height: 100vh;
        padding: 28px 30px 26px;
        position: relative;
      }

      .brand {
        align-self: start;
        grid-column: 1;
        grid-row: 1;
      }

      .brand h1 {
        font-size: 21px;
        font-weight: 500;
        letter-spacing: 0;
        line-height: 1;
        margin: 0 0 4px;
      }

      .brand span,
      .archive-meta,
      .status,
      .inspector {
        color: var(--muted);
        font-size: 12px;
      }

      .status {
        align-self: end;
        display: grid;
        gap: 10px;
        grid-column: 1;
        grid-row: 1;
        line-height: 1.4;
      }

      .status-row {
        display: flex;
        justify-content: space-between;
      }

      .field-stage {
        border: 1px solid var(--line);
        display: grid;
        grid-column: 2;
        grid-row: 1;
        grid-template-rows: auto minmax(0, 1fr);
        min-height: 0;
        min-width: 0;
        padding: 20px 22px 44px;
        position: relative;
      }

      .archive-meta {
        display: flex;
        justify-content: space-between;
        min-height: 16px;
        z-index: 4;
      }

      .field {
        background: rgba(247, 243, 235, 0.52);
        height: 100%;
        margin-top: 18px;
        min-height: 0;
        overflow: hidden;
        position: relative;
      }

      .record-node {
        color: inherit;
        display: grid;
        gap: 4px;
        left: calc(var(--x) * 100%);
        opacity: calc(0.48 + var(--score) * 0.48);
        position: absolute;
        text-decoration: none;
        top: calc(var(--y) * 100%);
        transform: translate(-50%, -50%);
        width: 84px;
        z-index: 3;
      }

      .relations {
        inset: 0;
        pointer-events: none;
        position: absolute;
      }

      .relations line {
        stroke: rgba(91, 95, 63, 0.42);
        stroke-width: 1;
      }

      .record-node:focus,
      .record-node:hover,
      .record-node.is-selected {
        outline: 1px solid rgba(37, 35, 29, 0.45);
        outline-offset: 8px;
      }

      .record-stripe {
        background: var(--olive);
        height: 4px;
        width: calc(28px + var(--score) * 42px);
      }

      .record-stripe:nth-child(2n) { opacity: 0.72; width: calc(14px + var(--score) * 28px); }
      .record-stripe:nth-child(3n) { opacity: 0.56; width: calc(28px + var(--score) * 28px); }

      .record-node[data-density="high"] .record-stripe { background: var(--warm); }
      .record-node[data-density="medium"] .record-stripe { background: var(--olive); }
      .record-node[data-density="low"] .record-stripe { background: var(--soft); }

      .inspector {
        border: 1px solid var(--line);
        display: grid;
        grid-column: 3;
        grid-row: 1;
        grid-template-rows: auto auto 1fr auto;
        min-height: 0;
        padding: 26px;
      }

      .inspector h2 {
        color: var(--ink);
        font-size: 17px;
        font-weight: 500;
        letter-spacing: 0;
        margin: 0 0 22px;
      }

      .inspector dl {
        border-bottom: 1px solid var(--line);
        border-top: 1px solid var(--line);
        display: grid;
        gap: 7px;
        grid-template-columns: 1fr 1fr;
        margin: 0 0 22px;
        padding: 16px 0;
      }

      .inspector dt { color: var(--muted); }
      .inspector dd { color: var(--ink); margin: 0; }

      .excerpt {
        color: var(--ink);
        font-family: "Iowan Old Style", "Apple SD Gothic Neo", "Noto Serif KR", serif;
        font-size: 15px;
        line-height: 1.8;
        margin: 0;
      }

      .thumbs {
        align-content: end;
        display: grid;
        gap: 8px;
        grid-template-columns: repeat(4, 1fr);
        margin-top: 24px;
      }

      .thumb {
        aspect-ratio: 1;
        background: var(--paper-2);
        border: 1px solid var(--line);
        overflow: hidden;
      }

      .thumb img {
        height: 100%;
        object-fit: cover;
        width: 100%;
      }

      .thumb.fallback {
        background: var(--paper-2);
      }

      .open-link {
        color: var(--ink);
        display: inline-flex;
        font-size: 14px;
        justify-self: start;
        margin-top: 24px;
        text-decoration: none;
      }

      .open-link::after {
        content: "→";
        margin-left: 18px;
      }
    </style>
  </head>
  <body>
    <main class="archive-shell">
      <section class="brand" aria-label="archive identity">
        <h1>Ydnil-poh <span>archive</span></h1>
      </section>

      <section class="field-stage" aria-label="semantic archive field">
        <div class="archive-meta">
          <span>archive as of</span>
          <span>{archiveDate}</span>
        </div>
        <div class="field" id="field">
          <svg class="relations" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {lines.map((line) => line && <line x1={line.x1} y1={line.y1} x2={line.x2} y2={line.y2} />)}
          </svg>
          {fieldRecords.map((record, index) => {
            const density = record.score > 0.72 ? 'high' : record.score > 0.38 ? 'medium' : 'low';
            return (
              <a
                class={`record-node ${index === 0 ? 'is-selected' : ''}`}
                data-record-id={record.id}
                data-density={density}
                href={record.url}
                style={`--x:${record.position.x};--y:${record.position.y};--score:${record.score};`}
              >
                {Array.from({ length: 9 }).map(() => <span class="record-stripe" />)}
              </a>
            );
          })}
        </div>
      </section>

      <aside class="inspector" aria-label="selected record">
        <h2 id="detail-title">{selected?.title ?? 'empty archive'}</h2>
        <dl>
          <dt>score</dt><dd id="detail-score">{selected ? selected.score.toFixed(2) : '0.00'}</dd>
          <dt>cluster</dt><dd id="detail-cluster">{selected ? `# ${selected.cluster}` : '-'}</dd>
          <dt>created</dt><dd id="detail-date">{selected ? selected.date.slice(0, 10) : '-'}</dd>
          <dt>type</dt><dd id="detail-type">{selected?.type ?? '-'}</dd>
        </dl>
        <p class="excerpt" id="detail-excerpt">{selected?.excerpt ?? '기록이 쌓이면 이곳에 의미 밀도가 생깁니다.'}</p>
        <div>
          <div class="thumbs" id="detail-thumbs">
            {selected?.imageUrls.length
              ? selected.imageUrls.slice(0, 8).map((url) => <span class="thumb"><img src={url} alt={selected.coverAlt} /></span>)
              : Array.from({ length: 8 }).map(() => <span class="thumb fallback" />)}
          </div>
          <a class="open-link" id="detail-open" href={selected?.url ?? '/archive-manifest.json'}>open</a>
        </div>
      </aside>

      <section class="status" aria-label="archive state">
        <div class="status-row"><span>records</span><span>{fieldRecords.length}</span></div>
        <div class="status-row"><span>clusters</span><span>{new Set(fieldRecords.map((record) => record.cluster)).size}</span></div>
        <div class="status-row"><span>view</span><span>field</span></div>
        <div class="status-row"><span>sleep</span><span>nightly</span></div>
      </section>
    </main>

    <script type="application/json" id="archive-records">{JSON.stringify(fieldRecords)}</script>
    <script type="module">
      const records = JSON.parse(document.getElementById('archive-records')?.textContent || '[]');
      const nodes = [...document.querySelectorAll('.record-node')];
      const title = document.getElementById('detail-title');
      const score = document.getElementById('detail-score');
      const cluster = document.getElementById('detail-cluster');
      const date = document.getElementById('detail-date');
      const type = document.getElementById('detail-type');
      const excerpt = document.getElementById('detail-excerpt');
      const thumbs = document.getElementById('detail-thumbs');
      const open = document.getElementById('detail-open');

      function selectRecord(record) {
        nodes.forEach((node) => node.classList.toggle('is-selected', node.dataset.recordId === record.id));
        title.textContent = record.title;
        score.textContent = Number(record.score).toFixed(2);
        cluster.textContent = `# ${record.cluster}`;
        date.textContent = String(record.date).slice(0, 10);
        type.textContent = record.type;
        excerpt.textContent = record.excerpt;
        open.href = record.url;
        thumbs.innerHTML = '';

        const images = record.imageUrls?.length ? record.imageUrls.slice(0, 8) : Array.from({ length: 8 }, () => '');
        for (const image of images) {
          const item = document.createElement('span');
          item.className = image ? 'thumb' : 'thumb fallback';
          if (image) {
            const img = document.createElement('img');
            img.src = image;
            img.alt = record.coverAlt || '';
            item.appendChild(img);
          }
          thumbs.appendChild(item);
        }
      }

      async function incrementRecord(id) {
        const url = import.meta.env.PUBLIC_SUPABASE_URL;
        const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
        if (!url || !key) return;
        await fetch(`${url}/rest/v1/rpc/increment_record_view`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: key, Authorization: `Bearer ${key}` },
          body: JSON.stringify({ record_slug: id }),
        });
      }

      nodes.forEach((node) => {
        node.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          const record = records.find((item) => item.id === node.dataset.recordId);
          if (!record) return;
          selectRecord(record);
          incrementRecord(record.id).catch(() => {});
        });
      });
    </script>
  </body>
</html>
