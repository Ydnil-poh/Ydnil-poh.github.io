---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const stripExtension = (id) => id.replace(/\.(md|markdown|mdx)$/i, '');

const parsed = posts.map((post) => {
  const body = post.body ?? '';
  const textCount = body.replace(/\s/g, '').length;
  const imageMarkdownCount = (body.match(/!\[[^\]]*\]\([^)]*\)/g) ?? []).length;
  const imageHtmlCount = (body.match(/<img\b[^>]*>/gi) ?? []).length;
  const imageCount = imageMarkdownCount + imageHtmlCount;
  const hasEmbed = /<(iframe|video|embed)\b[^>]*>/i.test(body) ? 1 : 0;

  return {
    id: stripExtension(post.id),
    slug: stripExtension(post.id),
    title: post.data.title,
    location: post.data.location,
    date: post.data.date.toISOString(),
    url: `/posts/${stripExtension(post.id)}/`,
    text_count: textCount,
    image_count: imageCount,
    has_embed: hasEmbed,
  };
});
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interactive Spiral Archive</title>
    <style>
      :root { --bg:#EAECE6; --empty:#DFE2D9; --top:#E65A28; --mid:#3D4A3E; --base:#607261; }
      *{box-sizing:border-box}
      body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,'Apple SD Gothic Neo','Noto Sans KR',sans-serif;color:#243024}
      .shell{padding:24px}
      .board-wrap{overflow:auto}
      .grid-container{
        display:grid !important;
        grid-template-columns:repeat(11,100px) !important;
        grid-template-rows:repeat(9,75px) !important;
        gap:12px !important;
        width:max-content !important;
        height:max-content !important;
        margin:40px auto !important;
        padding:20px;
        position:relative;
      }
      .grid-item,.placeholder-cell{
        width:100px !important;
        height:75px !important;
        box-sizing:border-box !important;
        border-radius:6px;
        grid-column:auto;
        grid-row:auto;
      }
      .placeholder-cell{background:var(--empty);border:1px solid #cfd4c8}
      .grid-item{cursor:pointer;will-change:transform;transition:transform .55s cubic-bezier(.22,.8,.2,1), background-color .25s ease;display:block}
      .grid-item.shrink{transform:scale(.96)}
      .meta{margin:8px 0 12px;color:#4a554b;font-size:14px}
      .debug{margin:0 0 10px;color:#2f3a30;font-size:13px}
      .modal{position:fixed;inset:0;background:rgba(18,24,18,.6);display:none;align-items:center;justify-content:center;padding:24px;z-index:20}
      .modal.open{display:flex}
      .sheet{background:#f5f6f1;width:min(860px,94vw);max-height:90vh;overflow:auto;padding:24px;border-radius:8px;transform:scale(.95);opacity:.4;transition:transform .28s ease, opacity .28s ease}
      .modal.open .sheet{transform:scale(1);opacity:1}
      .close{float:right}
      @media (max-width:768px){
        .board-wrap{overflow-x:auto}
        .grid-container{transform:rotate(90deg);transform-origin:center center; margin:180px 0 !important;}
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <h1 style="text-align:center;">ydnil stroll</h1>
      <p class="meta">99칸(11×9) 달팽이형 매트릭스 · 마크다운 자동 파싱 + Supabase 조회수 반영</p>
      <p id="postCount" class="debug" aria-live="polite"></p>
      <section class="board-wrap grid-container-wrap"><div id="board" class="grid-container" aria-label="spiral board">
        {Array.from({ length: 99 }).map(() => <div class="placeholder-cell"></div>)}
      </div></section>
    </main>

    <aside id="modal" class="modal" aria-hidden="true">
      <article class="sheet">
        <button id="closeModal" class="close">닫기</button>
        <h2 id="modalTitle"></h2>
        <p id="modalMeta" class="meta"></p>
        <div id="modalBody"></div>
      </article>
    </aside>

    <script type="application/json" id="seed-posts">{JSON.stringify(parsed)}</script>
    <script type="module">
      const seedPosts = JSON.parse(document.getElementById('seed-posts').textContent || '[]');
      const board = document.getElementById('board');
      const modal = document.getElementById('modal');
      const modalTitle = document.getElementById('modalTitle');
      const modalMeta = document.getElementById('modalMeta');
      const modalBody = document.getElementById('modalBody');
      const postCount = document.getElementById('postCount');
      document.getElementById('closeModal').addEventListener('click', () => modal.classList.remove('open'));

      const COLS = 11, ROWS = 9;
      const CENTER = { c: 5, r: 4 }; // 0-index => [6열,5행]
      let isAnimating = false;
      let posts = seedPosts.map((p)=>({ ...p, views:0, trackbacks:0 }));

      function spiralPositions(cols, rows, center){
        const dirs = [[1,0],[0,1],[-1,0],[0,-1]];
        let step=1, d=0, c=center.c, r=center.r;
        const out=[];
        if (c>=0&&c<cols&&r>=0&&r<rows) out.push({c,r});
        while(out.length<cols*rows){
          for(let rep=0; rep<2; rep++){
            for(let i=0;i<step;i++){
              c += dirs[d][0]; r += dirs[d][1];
              if(c>=0&&c<cols&&r>=0&&r<rows) out.push({c,r});
              if(out.length>=cols*rows) return out;
            }
            d=(d+1)%4;
          }
          step++;
        }
        return out;
      }
      const slots = spiralPositions(COLS, ROWS, CENTER);

      function score(p){ return (p.text_count*0.1)+(p.image_count*15)+(p.has_embed*20)+(p.views*2.5); }
      function tierColor(idx,total){ const pct = total===0?1:(idx+1)/total; if(pct<=0.15) return '#E65A28'; if(pct<=0.4) return '#3D4A3E'; return '#607261'; }

      async function fetchLive(){
        const url = import.meta.env.PUBLIC_SUPABASE_URL;
        const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
        if(!url || !key) return;
        const ids = posts.map(p=>p.id);
        if(!ids.length) return;
        const q = encodeURIComponent(ids.join(','));
        const res = await fetch(`${url}/rest/v1/posts?select=id,views,trackbacks&id=in.(${q})`, { headers:{ apikey:key, Authorization:`Bearer ${key}` } });
        if(!res.ok) return;
        const rows = await res.json();
        const m = new Map(rows.map(r=>[r.id,r]));
        posts = posts.map(p=>({ ...p, views: m.get(p.id)?.views ?? 0, trackbacks: m.get(p.id)?.trackbacks ?? 0 }));
      }

      function render(){
        board.innerHTML='';
        const grid = Array.from({ length: COLS * ROWS }, () => ({ type: 'placeholder' }));
        const ranked=[...posts].sort((a,b)=>score(b)-score(a));

        if (postCount) {
          postCount.textContent = `현재 업로드된 포스트 개수: ${ranked.length}개`;
        }

        ranked.forEach((post, idx) => {
          const pos = slots[idx];
          if (!pos) return;
          const linear = pos.r * COLS + pos.c;
          grid[linear] = { type: 'post', post, rank: idx };
        });

        grid.forEach((cell, linearIdx) => {
          const c = (linearIdx % COLS) + 1;
          const r = Math.floor(linearIdx / COLS) + 1;

          if (cell.type === 'placeholder') {
            const ph=document.createElement('div');
            ph.className='placeholder-cell';
            ph.style.gridColumn = `${c}`;
            ph.style.gridRow = `${r}`;
            board.appendChild(ph);
            return;
          }

          const { post, rank } = cell;
          const el=document.createElement('a');
          el.className='grid-item';
          el.href=post.url;
          el.dataset.id=post.id;
          el.style.gridColumn = `${c}`;
          el.style.gridRow = `${r}`;
          el.style.backgroundColor=tierColor(rank, ranked.length);
          el.addEventListener('click', (e)=>onCellClick(e,post));
          board.appendChild(el);
        });
      }

      async function onCellClick(e, post){
        e.preventDefault();
        if(isAnimating) return; // 0단계
        isAnimating=true;
        const el=e.currentTarget;

        // 1단계
        el.classList.add('shrink'); await new Promise(r=>setTimeout(r,100)); el.classList.remove('shrink');

        // 2단계
        posts = posts.map(p=>p.id===post.id?{...p, views:p.views+1}:p);
        render();
        incrementView(post.id).catch(()=>{});

        // 3단계
        await new Promise(r=>setTimeout(r,560));

        // 4단계
        await openPost(post);
        isAnimating=false;
      }

      async function incrementView(id){
        const url = import.meta.env.PUBLIC_SUPABASE_URL;
        const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
        if(!url || !key) return;
        await fetch(`${url}/rest/v1/rpc/increment_post_view`, { method:'POST', headers:{ 'Content-Type':'application/json', apikey:key, Authorization:`Bearer ${key}` }, body: JSON.stringify({ post_id:id }) });
      }

      async function openPost(post){
        const res = await fetch(post.url);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html,'text/html');
        const article = doc.querySelector('article');
        modalTitle.textContent = post.title;
        modalMeta.textContent = `${new Date(post.date).toLocaleDateString('ko-KR')} · ${post.location}`;
        modalBody.innerHTML = article ? article.innerHTML : '<p>본문을 불러오지 못했습니다.</p>';
        modal.classList.add('open');
      }

      fetchLive().finally(render);
    </script>
  </body>
</html>
