---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

const cells = posts
  .map((post) => {
    const body = post.body ?? '';
    const imageCount = (body.match(/!\[[^\]]*\]\([^)]*\)/g) ?? []).length;
    const charCount = body.replace(/\s/g, '').length;
    const activity = post.data.views + post.data.trackbacks * 8;
    const density = clamp(0.18 + Math.log10(activity + 1) * 0.28, 0.18, 0.9);
    const score = charCount * 0.01 + imageCount * 18 + activity * 0.7;
    return { post, density, score };
  })
  .sort((a, b) => b.score - a.score);

const cellCount = cells.length;
const side = Math.max(1, Math.ceil(Math.sqrt(cellCount))); // 1x1, 2x2, 3x3...
const totalSlots = side * side;
const emptySlots = Math.max(0, totalSlots - cellCount);
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ydnil Strolls</title>
    <style>
      :root { --bg:#f6f6f3; --text:#202020; --muted:#737373; --rule:#e4e2db; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--text); font-family:'Iowan Old Style','Apple SD Gothic Neo','Noto Serif KR',serif; }
      .shell { max-width:1440px; margin:0 auto; padding:3.6rem 1.4rem 5rem; }
      .topbar { border-bottom:1px solid var(--rule); padding-bottom:1.2rem; margin-bottom:2.1rem; }
      .brand { margin:0; font-size:1.62rem; }
      .intro { margin:.62rem 0 0; color:var(--muted); line-height:1.75; }

      .grid-wrap { overflow-x:auto; padding-bottom:.3rem; }
      .grid {
        --gap:.8rem;
        --grid-max: min(92vw, 1080px);
        --cell-size: calc((var(--grid-max) - (var(--grid-side) - 1) * var(--gap)) / var(--grid-side));
        display:grid;
        width:max-content;
        margin:0 auto;
        grid-template-columns: repeat(var(--grid-side), var(--cell-size));
        gap:var(--gap);
      }
      .cell,
      .placeholder {
        border:1px solid var(--rule);
        width:var(--cell-size);
        height:var(--cell-size);
      }
      .cell {
        position:relative;
        display:block;
        border-radius:2px;
        overflow:hidden;
        background:
          radial-gradient(circle at 30% 30%, rgba(255,255,255,.28), rgba(255,255,255,.06) 42%, transparent 70%),
          linear-gradient(160deg, rgba(36,36,36, calc(var(--density) * .78)), rgba(36,36,36, calc(var(--density) * .38)) 55%, rgba(36,36,36,.08));
        transition: transform .18s ease, filter .18s ease;
      }
      .cell:hover { transform: translateY(-2px); filter: saturate(1.08); }
      .cell:focus-visible { outline: 2px solid #9b968a; outline-offset: 2px; }

      .placeholder {
        border-style:dashed;
        opacity:.45;
        background:linear-gradient(135deg, rgba(228,226,219,.28), rgba(228,226,219,.06));
      }

      @media (max-width: 760px) {
        .shell { padding:2.4rem 1rem 3.5rem; }
        .grid { --gap:.58rem; --grid-max: 94vw; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <h1 class="brand">뚜벅뚜벅 Ydnil · Bubble Grid</h1>
        <p class="intro">셀은 색면으로만 존재합니다. 포스트 수가 늘어나면 정방형 그리드가 커지며, 비어 있는 슬롯은 빈 셀(placeholder)로 남겨 전체 구조를 유지합니다.</p>
      </header>

      <section class="grid-wrap" aria-label="bubble post grid">
        <div class="grid" style={`--grid-side:${side};`}>
          {cells.map(({ post, density }) => (
            <a
              class="cell"
              href={`/posts/${post.id.replace(/\.md$/, '')}/`}
              style={`--density:${density};`}
              aria-label={post.data.title}
              title={post.data.title}
            ></a>
          ))}
          {Array.from({ length: emptySlots }).map(() => <div class="placeholder" aria-hidden="true"></div>)}
        </div>
      </section>
    </main>
  </body>
</html>
