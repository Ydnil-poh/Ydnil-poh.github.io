---
import manifest from '../../public/archive-manifest.json';

const COLS = 28;
const ROWS = 18;
const totalSlots = COLS * ROWS;

type ManifestRecord = (typeof manifest.records)[number];

function nearestOpenSlot(preferred: number, occupied: Set<number>) {
  if (!occupied.has(preferred)) return preferred;
  const preferredCol = preferred % COLS;
  const preferredRow = Math.floor(preferred / COLS);
  let best = -1;
  let bestDistance = Infinity;

  for (let index = 0; index < totalSlots; index += 1) {
    if (occupied.has(index)) continue;
    const col = index % COLS;
    const row = Math.floor(index / COLS);
    const distance = Math.abs(col - preferredCol) + Math.abs(row - preferredRow);
    if (distance < bestDistance) {
      best = index;
      bestDistance = distance;
    }
  }
  return best;
}

function slotFromPosition(record: ManifestRecord, occupied: Set<number>) {
  const preferredCol = Math.max(0, Math.min(COLS - 1, Math.floor(record.position.x * COLS)));
  const preferredRow = Math.max(0, Math.min(ROWS - 1, Math.floor(record.position.y * ROWS)));
  const slot = nearestOpenSlot(preferredRow * COLS + preferredCol, occupied);
  occupied.add(slot);
  return {
    ...record,
    slot,
    position: {
      ...record.position,
      col: slot % COLS,
      row: Math.floor(slot / COLS),
    },
  };
}

const occupied = new Set<number>();
const fieldRecords = manifest.records.map((record) => slotFromPosition(record, occupied));
const occupiedSlots = new Set(fieldRecords.map((record) => record.slot));
const emptyTiles = Array.from({ length: totalSlots }, (_, slot) => ({
  slot,
  col: slot % COLS,
  row: Math.floor(slot / COLS),
  tone: (slot * 13 + Math.floor(slot / COLS) * 7) % 9,
})).filter((tile) => !occupiedSlots.has(tile.slot));

const recordById = new Map(fieldRecords.map((record) => [record.id, record]));
const selected = fieldRecords[0];
const backendConfig = {
  url: import.meta.env.PUBLIC_SUPABASE_URL ?? '',
  key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '',
};
const archiveDate = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium' }).format(new Date(manifest.generatedAt));
const clusterCount = new Set(fieldRecords.map((record) => record.cluster)).size;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ydnil-poh Archive Field</title>
    <style>
      :root {
        --paper: #ede8de;
        --paper-2: #f7f3eb;
        --ink: #25231d;
        --muted: #6f6b60;
        --line: rgba(92, 83, 67, 0.2);
        --soft: rgba(107, 105, 83, 0.34);
        --olive: rgba(91, 95, 63, 0.62);
        --warm: rgba(197, 112, 67, 0.7);
      }

      * { box-sizing: border-box; }

      body {
        background: var(--paper);
        color: var(--ink);
        font-family: "Inter", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
        margin: 0;
        min-height: 100vh;
      }

      body::before {
        background: radial-gradient(circle at 50% 45%, rgba(255,255,255,0.5), transparent 58%);
        content: "";
        inset: 0;
        pointer-events: none;
        position: fixed;
      }

      .archive-shell {
        display: grid;
        gap: 24px;
        grid-template-columns: 178px minmax(920px, 1fr);
        grid-template-rows: minmax(0, 1fr);
        height: 100vh;
        padding: 22px 30px 20px;
        position: relative;
      }

      .brand {
        left: 30px;
        position: fixed;
        top: 22px;
        width: 178px;
        z-index: 10;
      }

      .brand h1 {
        font-size: 21px;
        font-weight: 500;
        line-height: 1;
        margin: 0 0 4px;
      }

      .brand span,
      .archive-meta,
      .status,
      .inspector,
      .legend,
      .sleep-note { color: var(--muted); font-size: 12px; }

      .status {
        bottom: 20px;
        display: grid;
        gap: 10px;
        left: 30px;
        line-height: 1.4;
        position: fixed;
        width: 178px;
        z-index: 10;
      }

      .status-row { display: flex; justify-content: space-between; }

      .field-stage {
        border: 1px solid var(--line);
        display: grid;
        grid-column: 2;
        grid-row: 1;
        grid-template-rows: auto minmax(0, 1fr) auto;
        min-height: 0;
        min-width: 0;
        padding: 20px 22px 22px;
        position: relative;
      }

      .archive-meta { display: flex; justify-content: space-between; min-height: 16px; z-index: 4; }

      .field-scroll {
        min-height: 0;
        min-width: 0;
        overflow: hidden;
        padding-bottom: 6px;
      }

      .field {
        background: rgba(247, 243, 235, 0.52);
        display: grid;
        gap: 1px;
        grid-template-columns: repeat(var(--cols), minmax(16px, 1fr));
        grid-template-rows: repeat(var(--rows), minmax(16px, 1fr));
        height: 100%;
        margin-top: 18px;
        min-height: 0;
        min-width: 0;
        background-image: linear-gradient(rgba(92, 83, 67, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(92, 83, 67, 0.08) 1px, transparent 1px);
        background-size: calc((100% - 36px) / var(--cols)) calc((100% - 36px) / var(--rows));
        background-position: 18px 18px;
        overflow: hidden;
        padding: 18px;
        position: relative;
      }

      .empty-tile,
      .record-node {
        align-self: stretch;
        display: block;
        grid-column: calc(var(--col) + 1);
        grid-row: calc(var(--row) + 1);
        position: relative;
      }

      .empty-tile {
        background: rgba(247, 243, 235, calc(0.04 + var(--tone) * 0.012));
        border: 0;
        z-index: 1;
      }

      .record-node {
        background: rgba(247, 243, 235, 0.55);
        border: 1px solid rgba(92, 83, 67, 0.2);
        color: inherit;
        opacity: calc(0.58 + var(--score) * 0.36);
        text-decoration: none;
        z-index: 3;
      }

      .record-node::before,
      .record-node::after { background: var(--olive); content: ""; opacity: 0.72; position: absolute; }
      .record-node::before { height: 3px; left: 18%; top: 30%; width: 64%; box-shadow: -4px 6px 0 var(--olive), 6px 12px 0 var(--olive); }
      .record-node::after { height: 3px; left: 28%; top: 58%; width: 44%; box-shadow: -6px 6px 0 var(--olive), 8px -12px 0 var(--olive); }

      .record-node:focus,
      .record-node:hover,
      .record-node.is-selected { outline: 1px solid rgba(37, 35, 29, 0.45); outline-offset: 4px; }

      .record-node[data-density="high"]::before,
      .record-node[data-density="high"]::after { background: var(--warm); box-shadow: -4px 6px 0 var(--warm), 6px 12px 0 var(--warm); }
      .record-node[data-density="medium"]::before,
      .record-node[data-density="medium"]::after { background: var(--olive); }
      .record-node[data-density="low"]::before,
      .record-node[data-density="low"]::after { background: var(--soft); box-shadow: -4px 6px 0 var(--soft), 6px 12px 0 var(--soft); }

      .legend { border-top: 1px solid var(--line); display: flex; gap: 18px; justify-content: space-between; padding-top: 14px; }
      .legend b { color: var(--ink); font-weight: 500; }
      .sleep-note { margin-left: auto; }

      .modal-backdrop {
        background: rgba(37, 35, 29, 0.18);
        inset: 0;
        opacity: 0;
        pointer-events: none;
        position: fixed;
        transition: opacity 180ms ease;
        z-index: 20;
      }

      .modal-backdrop.is-open {
        opacity: 1;
        pointer-events: auto;
      }

      .inspector {
        background: rgba(247, 243, 235, 0.96);
        border-left: 1px solid var(--line);
        box-shadow: -20px 0 48px rgba(37, 35, 29, 0.12);
        display: grid;
        grid-template-rows: auto auto auto 1fr auto;
        inset: 0 0 0 auto;
        max-width: min(420px, 100vw);
        min-height: 100vh;
        opacity: 0;
        padding: 28px;
        pointer-events: none;
        position: fixed;
        transform: translateX(100%);
        transition: transform 220ms ease, opacity 160ms ease;
        width: 360px;
        z-index: 30;
      }

      .inspector.is-open {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(0);
      }

      .inspector-header {
        align-items: start;
        display: flex;
        gap: 18px;
        justify-content: space-between;
      }

      .close-detail {
        background: transparent;
        border: 0;
        color: var(--muted);
        cursor: pointer;
        font: inherit;
        padding: 0;
      }

      .close-detail:hover { color: var(--ink); }

      .inspector-date { color: var(--ink); font-size: 15px; font-weight: 400; letter-spacing: 0.02em; margin: 0 0 28px; }
      .texture-preview { aspect-ratio: 4 / 3; background: rgba(247, 243, 235, 0.6); border: 1px solid var(--line); display: grid; margin-bottom: 24px; overflow: hidden; place-items: center; position: relative; }
      .texture-preview::after { background-image: linear-gradient(90deg, rgba(91, 95, 63, 0.12) 1px, transparent 1px), linear-gradient(rgba(197, 112, 67, 0.08) 1px, transparent 1px); background-size: 14px 18px; content: ""; inset: 0; mix-blend-mode: multiply; opacity: 0.72; position: absolute; }
      .texture-preview img { filter: saturate(0.78) contrast(0.92); height: 100%; object-fit: cover; width: 100%; }
      .texture-placeholder { color: var(--muted); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }

      .related { border-top: 1px solid var(--line); display: grid; gap: 14px; margin-top: 4px; padding-top: 18px; }
      .related-header { align-items: baseline; display: flex; justify-content: space-between; }
      .related h3 { color: var(--muted); font-size: 12px; font-weight: 400; margin: 0; }
      .related-count { color: var(--ink); font-size: 24px; line-height: 1; }
      .related-list { display: flex; flex-wrap: wrap; gap: 8px; }
      .related-marker { align-items: center; aspect-ratio: 1; background: rgba(91, 95, 63, 0.1); border: 1px solid var(--line); color: transparent; display: inline-grid; overflow: hidden; place-items: center; position: relative; text-decoration: none; width: 34px; }
      .related-marker::before { background: var(--olive); border-radius: 999px; content: ""; height: 7px; opacity: 0.78; width: 7px; }
      .related-marker:nth-child(2n)::before { background: var(--warm); }
      .related-marker:nth-child(3n)::before { box-shadow: -7px 5px 0 var(--soft), 7px -5px 0 var(--olive); }

      .open-link { align-self: end; color: var(--ink); display: inline-flex; font-size: 14px; justify-self: start; margin-top: 24px; text-decoration: none; }

    </style>
  </head>
  <body>
    <main class="archive-shell">
      <section class="brand" aria-label="archive identity">
        <h1>Ydnil-poh <span>archive</span></h1>
      </section>

      <section class="field-stage" aria-label="semantic archive field">
        <div class="archive-meta">
          <span>archive as of</span>
          <span>{archiveDate}</span>
        </div>
        <div class="field-scroll">
          <div class="field" id="field" style={`--cols:${COLS};--rows:${ROWS};`}>
            {emptyTiles.map((tile) => <span class="empty-tile" style={`--col:${tile.col};--row:${tile.row};--tone:${tile.tone};`} aria-hidden="true"></span>)}
            {fieldRecords.map((record, index) => {
              const density = record.score > 0.72 ? 'high' : record.score > 0.38 ? 'medium' : 'low';
              return (
                <a
                  class="record-node"
                  data-record-id={record.id}
                  data-density={density}
                  href={record.url}
                  style={`--col:${record.position.col};--row:${record.position.row};--score:${record.score};`}
                  aria-label={record.title}
                ></a>
              );
            })}
          </div>
        </div>
        <div class="legend" aria-label="field legend">
          <span><b>{fieldRecords.length}</b> records</span>
          <span><b>{emptyTiles.length}</b> waiting cells</span>
          <span>score = semantic density</span>
          <span class="sleep-note">sleep rebuild: nightly</span>
        </div>
      </section>

      <aside class="inspector" id="detail-panel" aria-label="selected record" aria-hidden="true">
        <div class="inspector-header">
          <p class="inspector-date" id="detail-date">{selected ? selected.date.slice(0, 10) : '-'}</p>
          <button class="close-detail" id="detail-close" type="button">close</button>
        </div>
        <div class="texture-preview" id="detail-texture" aria-label={selected?.title ?? 'record texture'}>
          {selected?.imageUrls?.[0] ? <img src={selected.imageUrls[0]} alt="" /> : <span class="texture-placeholder">texture preview</span>}
        </div>
        <div class="related" aria-label="nearby records">
          <div class="related-header">
            <h3>Nearby Records</h3>
            <span class="related-count" id="detail-related-count">{selected?.related.length ?? 0}</span>
          </div>
          <div class="related-list" id="detail-related">
            {(selected?.related ?? []).slice(0, 8).map((id, index) => {
              const nearby = recordById.get(id);
              return nearby && <a class="related-marker" href={nearby.url} aria-label={`nearby record ${index + 1}`}>{index + 1}</a>;
            })}
          </div>
        </div>
        <a class="open-link" id="detail-open" href={selected?.url ?? '/archive-manifest.json'}>Open Record →</a>
      </aside>
      <div class="modal-backdrop" id="detail-backdrop" aria-hidden="true"></div>

      <section class="status" aria-label="archive state">
        <div class="status-row"><span>records</span><span>{fieldRecords.length}</span></div>
        <div class="status-row"><span>clusters</span><span>{clusterCount}</span></div>
        <div class="status-row"><span>view</span><span>field</span></div>
        <div class="status-row"><span>sleep</span><span>nightly</span></div>
      </section>
    </main>

    <script 
      type="application/json" 
      id="archive-records"
      set:html={JSON.stringify(fieldRecords)}
    ></script>
    <script
      type="application/json"
      id="archive-backend"
      set:html={JSON.stringify(backendConfig)}
    ></script>
    <script type="module">
      const records = JSON.parse(document.getElementById('archive-records')?.textContent || '[]');
      const backend = JSON.parse(document.getElementById('archive-backend')?.textContent || '{}');
      const nodes = [...document.querySelectorAll('.record-node')];
      const date = document.getElementById('detail-date');
      const open = document.getElementById('detail-open');
      const texture = document.getElementById('detail-texture');
      const related = document.getElementById('detail-related');
      const relatedCount = document.getElementById('detail-related-count');
      const panel = document.getElementById('detail-panel');
      const close = document.getElementById('detail-close');
      const backdrop = document.getElementById('detail-backdrop');

      function textureMarkup(record) {
        const texture = record.texture;

        if (!texture?.cells?.length) {
          return '<span class="texture-placeholder">no texture</span>';
  }

  const cells = texture.cells;
  const width = texture.width || 32;
  const height = texture.height || 32;

  const rects = cells.map((value, index) => {
    const x = index % width;
    const y = Math.floor(index / width);

    const opacity = Math.max(0.05, value);

    return `
      <rect
        x="${x}"
        y="${y}"
        width="1"
        height="1"
        fill="currentColor"
        opacity="${opacity}"
      />
    `;
  }).join('');

  return `
    <svg
      viewBox="0 0 ${width} ${height}"
      preserveAspectRatio="none"
      style="width:100%;height:100%;color:rgba(91,95,63,.85)"
    >
      ${rects}
    </svg>
  `;
}

      function sessionId() {
        const key = 'ydnil-poh-archive-session';
        const existing = sessionStorage.getItem(key);
        if (existing) return existing;
        const next = crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(16).slice(2)}`;
        sessionStorage.setItem(key, next);
        return next;
      }

      function eventMetadata(extra = {}) {
        return {
          path: window.location.pathname,
          referrer: document.referrer || '',
          sessionId: sessionId(),
          ...extra,
        };
      }

      function applyAttentionMetrics(record, payload) {
        if (!payload || typeof payload !== 'object') return;
        if (Number.isFinite(Number(payload.views))) record.views = Number(payload.views);
        if (Number.isFinite(Number(payload.tileClicks))) record.tileClicks = Number(payload.tileClicks);
        if (Number.isFinite(Number(payload.opens))) record.opens = Number(payload.opens);
        if (Number.isFinite(Number(payload.pageViews))) record.pageViews = Number(payload.pageViews);
        if (Number.isFinite(Number(payload.runtimeScore))) record.runtimeScore = Number(payload.runtimeScore);
        if (Number.isFinite(Number(payload.humanModalOpen))) record.humanModalOpen = Number(payload.humanModalOpen);
        if (Number.isFinite(Number(payload.humanFullOpen))) record.humanFullOpen = Number(payload.humanFullOpen);
        if (Number.isFinite(Number(payload.humanScore))) record.humanScore = Number(payload.humanScore);
        if (Number.isFinite(Number(payload.machineAccess))) record.machineAccess = Number(payload.machineAccess);
        if (Number.isFinite(Number(payload.machineScore))) record.machineScore = Number(payload.machineScore);
      }

      async function fetchBackendAttention() {
        if (!backend.url || !backend.key || records.length === 0) return;
        const slugs = records.map((record) => `"${String(record.id).replaceAll('\"', '\\"')}"`).join(',');
        const endpoint = `${backend.url.replace(/\/$/, '')}/rest/v1/archive_records?select=slug,views,tile_clicks,opens,page_views,runtime_score,human_modal_open,human_full_open,human_score,machine_access,machine_score&slug=in.(${slugs})`;
        const response = await fetch(endpoint, {
          headers: { apikey: backend.key, Authorization: `Bearer ${backend.key}` },
        });
        if (!response.ok) return;
        const rows = await response.json();
        rows.forEach((row) => {
          const record = records.find((item) => item.id === row.slug);
          if (!record) return;
          applyAttentionMetrics(record, {
            views: row.views,
            tileClicks: row.tile_clicks,
            opens: row.opens,
            pageViews: row.page_views,
            runtimeScore: row.runtime_score,
            humanModalOpen: row.human_modal_open,
            humanFullOpen: row.human_full_open,
            humanScore: row.human_score,
            machineAccess: row.machine_access,
            machineScore: row.machine_score,
          });
        });
      }

      function relatedMarkup(record) {
        return (record.related || [])
          .map((id) => records.find((item) => item.id === id))
          .filter(Boolean)
          .slice(0, 8)
          .map((item, index) => `<a class="related-marker" href="${item.url}" aria-label="nearby record ${index + 1}">${index + 1}</a>`)
          .join('');
      }

      function openPanel() {
        panel.classList.add('is-open');
        backdrop.classList.add('is-open');
        panel.setAttribute('aria-hidden', 'false');
      }

      function closePanel() {
        panel.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        panel.setAttribute('aria-hidden', 'true');
        nodes.forEach((node) => node.classList.remove('is-selected'));
      }

      function selectRecord(record) {
        nodes.forEach((node) => node.classList.toggle('is-selected', node.dataset.recordId === record.id));
        date.textContent = String(record.date).slice(0, 10);
        open.href = record.url;
        texture.setAttribute('aria-label', `${record.title} texture`);
        texture.innerHTML = textureMarkup(record);
        relatedCount.textContent = String((record.related || []).length);
        related.innerHTML = relatedMarkup(record);
        openPanel();
      }

      async function recordArchiveEvent(record, eventType, metadata = {}) {
        if (!backend.url || !backend.key) return null;
        const response = await fetch(`${backend.url.replace(/\/$/, '')}/rest/v1/rpc/record_archive_event`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: backend.key, Authorization: `Bearer ${backend.key}` },
          body: JSON.stringify({
            record_slug: record.id,
            event_type: eventType,
            event_metadata: eventMetadata(metadata),
          }),
          keepalive: true,
        });
        if (!response.ok) return null;
        const payload = await response.json().catch(() => null);
        const result = Array.isArray(payload) ? payload[0] : payload;
        applyAttentionMetrics(record, result);
        return result;
      }

      close.addEventListener('click', closePanel);
      backdrop.addEventListener('click', closePanel);
      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePanel();
      });

      fetchBackendAttention().catch(() => {});

      open.addEventListener('click', () => {
        const record = records.find((item) => item.url === open.getAttribute('href'));
        if (record) recordArchiveEvent(record, 'record_open', { surface: 'detail_open' }).catch(() => {});
      });

      nodes.forEach((node) => {
        node.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          const record = records.find((item) => item.id === node.dataset.recordId);
          if (!record) return;
          selectRecord(record);
          recordArchiveEvent(record, 'tile_click', { surface: 'field' })
            .catch(() => {});
        });
      });
    </script>
  </body>
</html>
