---
import { getCollection } from 'astro:content';

const essays = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const dateFormat = new Intl.DateTimeFormat('ko-KR', { dateStyle: 'medium' });
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ydnil Strolls</title>
    <style>
      :root { --bg:#f6f6f3; --panel:#fff; --text:#202020; --muted:#737373; --rule:#e4e2db; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--text); font-family:'Iowan Old Style','Apple SD Gothic Neo','Noto Serif KR',serif; line-height:1.9; }
      .shell { max-width:760px; margin:0 auto; padding:4rem 1.25rem 5rem; }
      .topbar { border-bottom:1px solid var(--rule); padding-bottom:1.15rem; margin-bottom:2.5rem; }
      .brand { margin:0; font-size:1.45rem; letter-spacing:.02em; }
      .intro { margin:.6rem 0 0; color:var(--muted); font-size:.95rem; }
      .essay-list { display:grid; gap:3.4rem; }
      .essay { display:grid; gap:1.15rem; text-decoration:none; color:inherit; }
      .photo-frame { margin:0; border:1px solid #ddd9cf; background:var(--panel); padding:clamp(.35rem,1.1vw,.55rem); }
      .photo-surface { width:100%; aspect-ratio:4/3; background:linear-gradient(155deg,rgba(0,0,0,.05),rgba(0,0,0,.15)), radial-gradient(circle at 30% 30%, #ddd8cf 0%, #c8c3b8 40%, #a7a39a 100%); overflow:hidden; }
      .photo-surface img { width:100%; height:100%; object-fit:cover; display:block; }
      h2 { margin:0; font-size:1.5rem; font-weight:500; line-height:1.45; }
      .meta { margin:0; color:var(--muted); font-size:.92rem; }
      .excerpt { margin:0; font-size:1.03rem; }
      .tags { display:flex; flex-wrap:wrap; gap:.42rem; }
      .tag { border:1px solid var(--rule); color:#545454; padding:.16rem .55rem; font-size:.82rem; }
      .empty { color:var(--muted); }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <h1 class="brand">뚜벅뚜벅 Ydnil</h1>
        <p class="intro">광고 없는 미니멀 포토에세이 · 느린 보폭으로 기록하는 도시 산책</p>
      </header>

      {essays.length === 0 ? (
        <p class="empty">아직 발행된 포토에세이가 없습니다. `src/content/posts`에 첫 글을 추가해보세요.</p>
      ) : (
        <section class="essay-list" aria-label="photo essays">
          {essays.map((essay) => (
            <a class="essay" href={`/posts/${essay.id.replace(/\.md$/, '')}/`}>
              <figure class="photo-frame" aria-hidden="true">
                <div class="photo-surface">
                  {essay.data.cover ? (
                    <img src={essay.data.cover} alt={essay.data.coverAlt} loading="lazy" />
                  ) : null}
                </div>
              </figure>
              <header>
                <h2>{essay.data.title}</h2>
                <p class="meta">{dateFormat.format(essay.data.date)} · {essay.data.location}</p>
              </header>
              <p class="excerpt">{essay.data.excerpt}</p>
              <div class="tags">
                {essay.data.tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </section>
      )}
    </main>
  </body>
</html>
